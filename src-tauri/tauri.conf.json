{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodepad",
  "version": "0.1.0",
  "identifier": "com.nodepad.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Nodepad", "width": 900, "height": 700, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube-nocookie.com" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGRTRCRjI5OEI2ODlBOEIKUldTTG1taUxLYi9rNzNnZlQwTy85dEU5RHRlVFVUcTNWeE4yNXY2dThlQXdpekpYVjIxRTNIdWEK",
      "endpoints": [
        "https://github.com/kiran-brahma/nodepad-app/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
